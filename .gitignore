# Secretos: nunca al repo
.env
.env.*
!.env.example
*.key
service-role*

# Datos personales derivados de exports (nunca se versionan)
/private/
/exports/
*.export.json

# Sistema
node_modules/
.DS_Store
Thumbs.db

# Todo lo que escriben los jobs. El contenido real vive en db/ y esto
# es derivado, asi que no se versiona.
#
# Antes se ignoraban tres archivos sueltos y quedaron versionados los
# otros cinco. Entre ellos, uno con los nombres de las carpetas de
# trabajo -proyecto A, proyecto B- y otro con el
# perfil derivado de las conversaciones. Ninguno es secreto, pero son
# datos de una persona y de una institucion, y el repo no es lugar.
# Por eso ahora se ignora la carpeta entera y no una lista.
/jobs/salida/*
!/jobs/salida/.gitkeep
